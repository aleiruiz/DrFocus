# Copia este archivo como supabase/.env para `supabase functions serve` (está en .gitignore).
# En producción estos valores van en los secretos de la función: `supabase secrets set ...`.

# mock (por defecto, sin red) u openai
PLANNING_PROVIDER=mock
# Modelo rápido y económico de OpenAI; requerido si PLANNING_PROVIDER=openai
PLANNING_MODEL=
# Clave del proveedor; nunca en la app ni en el repositorio
PROVIDER_API_KEY=
DAILY_REQUEST_LIMIT=30
# info (una línea por solicitud) o error (solo fallos)
LOG_LEVEL=info

# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los pone Supabase automáticamente.
